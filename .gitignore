# ── Data files — never commit raw or real data ──────────────────────────────
# All CSV/Excel/JSON in data/ are local only; use data/sample/ for public demos
data/*.csv
data/*.xlsx
data/*.json
data/real/
data/cache/
# Allow the synthetic sample directory (synthetic demo data only — safe to share)
# Includes synthetic holdings/NAV, synthetic market data, and the demo yield curve,
# all generated by data/generate_synthetic_data.py. The download-sample-data button
# bundles these, so they must be committed for the feature to work off a fresh clone.
!data/sample/
!data/sample/**

# Generated output reports and charts
output/
liquidity_risk_tool/output/

# Refinitiv / LSEG licensed data — keep private
# The extractor code lives in integrations/refinitiv/ (safe to commit)
# but its outputs, cache files, and any real data must never be committed.
data/fetch_market_data.py
data/README_fetch_market_data.md
data/market_data_cache.csv
data/market_data_ALL.csv
data/market_data_ERRORS.csv
integrations/refinitiv/.env
integrations/refinitiv/secrets.py

# Internal documentation (not for public release)
docs/

# Local tooling
.claude/
liquidity_risk_tool/.claude/

# Vite build cache
frontend/.vite/
